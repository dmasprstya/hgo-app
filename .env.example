# Root .env.example
# Copy to backend/.env and frontend/.env before running

# ── Backend ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost/spk_hgo
REDIS_URL=redis://localhost:6379
SECRET_KEY=change-this-to-a-secure-32-char-key!!
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
DEBUG=true
MAX_UPLOAD_SIZE_MB=10

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── Production (Render + Supabase + Upstash) ─────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://user:pass@aws-host:6543/db
# REDIS_URL=rediss://default:pass@upstash-host:6379  ← Note: rediss:// (SSL)
# SECRET_KEY=your-super-secret-key-at-least-32-chars
# CORS_ORIGINS=https://your-app.vercel.app
# ENVIRONMENT=production
# VITE_API_URL=https://spk-saw-api.onrender.com
